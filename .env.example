# 复制为项目根目录 .env；不要提交真实Cookie、密钥或账号数据库。
# 默认只监听本机。改为公开部署时必须使用HTTPS、反向代理与容量/安全验收。
HOST=127.0.0.1
PORT=4000
# 自定义域名时明确填写；本机默认只接受localhost/127.0.0.1/::1，防止DNS重绑定访问。
# HOTPOT_ALLOWED_HOSTS=localhost,127.0.0.1
# 本机代理可自动检测，也可明确指定（配置存在不代表平台访问一定成功）。
MEDIA_PROXY=
# 仅使用本人合法登录态；不能通过登录态绕过付费、私密或平台授权。
BILIBILI_COOKIE=
DOUYIN_COOKIE=
TIKTOK_COOKIE=
XIAOHONGSHU_COOKIE=
KUAISHOU_COOKIE=
# 官方API凭证可能有费用、额度或权限限制。
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
X_SEARCH_ARCHIVE=0
# 可选云端语义模型：设置后真实字幕会发送给该服务。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
